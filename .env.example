# ============================================================
# انسخ هذا الملف وأعد تسميته إلى .env
# Copy this file and rename it to .env
# ============================================================

# --- إعدادات MT5 ---
MT5_LOGIN=123456789          # رقم حسابك في MT5
MT5_PASSWORD=your_password   # كلمة المرور
MT5_SERVER=YourBroker-Demo   # اسم السيرفر (موجود في MT5)

# --- إعدادات التداول ---
TRADING_MODE=paper           # paper = ورقي | live = حقيقي
BASE_CURRENCY=USD
INITIAL_CAPITAL=10000

# --- إعدادات المخاطر ---
MAX_RISK_PER_TRADE=0.01      # 1% من رأس المال لكل صفقة
MAX_DAILY_DRAWDOWN=0.05      # 5% أقصى خسارة يومية
MAX_OPEN_POSITIONS=5

# --- قاعدة البيانات ---
DATABASE_URL=sqlite:///data/trading.db

# --- التسجيل ---
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
